# Copy this file to .env and fill in your own values. See README for all options.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dhanvantari?sslmode=verify-full

# Admin sign-in. Remove the # and choose your OWN password (at least 6 characters).
# It is applied every time the server starts. If left unset, the demo password "admin123" stays in use.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-own-strong-password

# JWT_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
